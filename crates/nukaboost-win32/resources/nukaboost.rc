// Recursos Win32 do NukaBoost: ícones de estado, informações de versão,
// manifesto e os diálogos nativos (About e aviso de segurança).
//
// Compilado a partir de `apps/nukaboost/build.rs` via `embed-resource`
// (veja o comentário ali sobre por que a compilação não acontece neste
// crate, mesmo os arquivos vivendo aqui). Ao alterar qualquer ID abaixo,
// altere também `src/resource_ids.rs` — os dois arquivos precisam
// permanecer sincronizados manualmente.

#pragma code_page(65001) // UTF-8

// `winres.h` (não `windows.h`) é o cabeçalho padrão para arquivos .rc
// somente de recursos: define os estilos (WS_*, DS_*, BS_*, SS_*, MF_*)
// sem puxar todo o restante do SDK.
#include <winres.h>

// ---------------------------------------------------------------------
// IDs — mantidos em sincronia manual com src/resource_ids.rs
// ---------------------------------------------------------------------

#define IDI_APP                   1
#define IDI_INACTIVE            101
#define IDI_ACTIVE               102
#define IDI_ERROR                103

#define IDD_ABOUT                201
#define IDD_SAFETY_WARNING       202

#define IDC_ABOUT_TITLE          1001
#define IDC_ABOUT_VERSION        1002
#define IDC_ABOUT_STATE          1003
#define IDC_ABOUT_DESC           1004
#define IDC_ABOUT_SCREEN_NOTE    1005
#define IDC_ABOUT_VENTILATION    1006
#define IDC_ABOUT_TERMINATION    1007
#define IDC_WARNING_TEXT_EN      1101
#define IDC_WARNING_TEXT_PT      1102
#define IDC_WARNING_CHECKBOX     1103

// Convenção padrão do compilador de recursos: -1 identifica controles
// puramente decorativos que o código Rust nunca precisa referenciar
// individualmente (o próprio ícone do diálogo About, por exemplo).
#define IDC_STATIC               -1

// ---------------------------------------------------------------------
// Ícone permanente do executável e ícones dinâmicos da área de notificação.
// O Explorer usa o recurso ICON de menor ID como ícone do aplicativo; ele
// deve ser sempre o ícone ativo, independentemente do estado exibido no tray.
// ---------------------------------------------------------------------

IDI_APP      ICON "../../../assets/active.ico"
IDI_INACTIVE ICON "../../../assets/inactive.ico"
IDI_ACTIVE   ICON "../../../assets/active.ico"
IDI_ERROR    ICON "../../../assets/error.ico"

// ---------------------------------------------------------------------
// Manifesto da aplicação (Common Controls v6, DPI, asInvoker)
// ---------------------------------------------------------------------

1 24 "nukaboost.manifest"

// ---------------------------------------------------------------------
// Informações de versão do executável
//
// `FileDescription` é deliberadamente mais longa que uma descrição comum:
// é o único texto que o Gerenciador de Tarefas (aba Detalhes), `tasklist
// /v` ou `Get-Process | Select Description` mostram sobre este processo
// antes de alguém — humano ou um agente automatizado decidindo encerrar
// processos "não-Windows" — o encerrar à força. Ver `docs/plano.md` (seção
// sobre encerramento fora de controle) para o raciocínio completo.
// ---------------------------------------------------------------------

1 VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Arthur Vinicius"
            VALUE "FileDescription",  "NukaBoost - keeps Windows awake during long tasks. Do NOT force-close while active: run 'nukaboostctl exit' or 'nukaboostctl stop' first, or lid/sleep settings may stay overridden until next logon."
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "NukaBoost"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Arthur Vinicius"
            VALUE "OriginalFilename", "NukaBoost.exe"
            VALUE "ProductName",      "NukaBoost"
            VALUE "ProductVersion",   "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// ---------------------------------------------------------------------
// Diálogo "About NukaBoost" (seção 3 do plano)
//
// Todo o texto visível é preenchido em tempo de execução por
// crates/nukaboost-win32/src/dialogs/about.rs via SetWindowTextW — os
// literais abaixo são apenas placeholders de layout, nunca exibidos.
// ---------------------------------------------------------------------

IDD_ABOUT DIALOGEX 0, 0, 260, 195
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NukaBoost"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_ACTIVE,           IDC_STATIC,           10,  10, 20, 20
    LTEXT           "NukaBoost",          IDC_ABOUT_TITLE,      40,  10, 210, 10, SS_NOPREFIX
    LTEXT           "Version",            IDC_ABOUT_VERSION,    40,  24, 210, 10
    LTEXT           "State",              IDC_ABOUT_STATE,      40,  38, 210, 10
    LTEXT           "",                   IDC_ABOUT_DESC,       10,  56, 240, 26, SS_LEFT
    LTEXT           "",                   IDC_ABOUT_SCREEN_NOTE,10,  85, 240, 18, SS_LEFT
    LTEXT           "",                   IDC_ABOUT_VENTILATION,10, 105, 240, 18, SS_LEFT
    LTEXT           "",                   IDC_ABOUT_TERMINATION,10, 125, 240, 36, SS_LEFT
    DEFPUSHBUTTON   "Close",              IDOK,                 200, 173, 50, 14
END

// ---------------------------------------------------------------------
// Diálogo do aviso de segurança inicial (seção 4 do plano)
//
// O texto bilíngue (EN + PT) e os rótulos localizados são preenchidos em
// tempo de execução por
// crates/nukaboost-win32/src/dialogs/warning.rs. Cada controle de texto
// mostra dois avisos concatenados (tampa/ventilação + encerramento fora de
// controle — subseção "Encerramento fora do controle do aplicativo" da
// seção 4), por isso a altura generosa: melhor sobrar espaço em branco do
// que cortar texto sem aviso visível.
// ---------------------------------------------------------------------

IDD_SAFETY_WARNING DIALOGEX 0, 0, 280, 235
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NukaBoost: Safety warning"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_WARNING_TEXT_EN,       10,  10, 260, 80, SS_LEFT
    LTEXT           "", IDC_WARNING_TEXT_PT,       10,  94, 260, 80, SS_LEFT
    CONTROL         "Do not show this warning again", IDC_WARNING_CHECKBOX, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,  10, 180, 260, 12
    DEFPUSHBUTTON   "OK",                IDOK,     220, 208, 50, 14
END
