<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifesto da aplicação NukaBoost.

  - Common Controls v6: necessário para que os controles dos diálogos
    (botões, caixa de seleção) usem os temas visuais atuais do Windows em
    vez do estilo clássico do Windows 95.
  - Reconhecimento de DPI por monitor (Per-Monitor V2): evita que o Windows
    aplique escalonamento de bitmap borrado nos diálogos nativos em telas
    de alta densidade ou em configurações com múltiplos monitores de DPIs
    diferentes.
  - `longPathAware`: inofensivo para este aplicativo, mas evita truncamento
    silencioso de caminhos longos ao ler/escrever arquivos de configuração
    e logs em `%LocalAppData%`.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="NukaBoost.App"
      version="1.0.0.0"
      processorArchitecture="*"
  />

  <dependency>
    <dependentAssembly>
      <assemblyIdentity
          type="win32"
          name="Microsoft.Windows.Common-Controls"
          version="6.0.0.0"
          processorArchitecture="*"
          publicKeyToken="6595b64144ccf1df"
          language="*"
      />
    </dependentAssembly>
  </dependency>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11 compatibility contract. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
      <dpiAware>true/pm</dpiAware>
    </asmv3:windowsSettings>
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <longPathAware>true</longPathAware>
    </asmv3:windowsSettings>
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <dpiAwareness>PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!--
          O NukaBoost nunca deve rodar elevado (seção 17: "Não rodar o tray
          como administrador"). `asInvoker` herda o nível de integridade do
          processo que o iniciou, sem solicitar elevação via UAC.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
