<?xml version="1.0" encoding="utf-8"?>
<!--
  NukaBoost per-user MSI (WiX Toolset 7).

  Execute from the repository root after building the Rust release profile:

    wix build installer\NukaBoost.wxs `
      -arch x64 `
      -b assets=assets `
      -b release=target\release `
      -ext WixToolset.UI.wixext `
      -ext WixToolset.Util.wixext `
      -out installer\NukaBoost.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="NukaBoost"
           Manufacturer="Arthur Vinicius"
           Version="1.0.1"
           ProductCode="D3736C6B-E0EA-466D-80DD-A44C14696FC7"
           UpgradeCode="9BA517E2-95B7-4E70-B5B0-1941905EF77B"
           Scope="perUser"
           Compressed="yes">

    <!-- UpgradeCode stays stable across releases; ProductCode changes once
         per version and remains stable across rebuilds of that version. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of NukaBoost is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="NukaBoostIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/arthru-vinicius/nukaboost" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/arthru-vinicius/nukaboost" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Icon Id="NukaBoostIcon" SourceFile="!(bindpath.assets)\active.ico" />

    <!-- AppSearch resolves the data directory during uninstall/upgrade.
         This avoids the illegal formatted-property reference that caused
         WIX1077 in the previous source. -->
    <Property Id="NUKABOOST_DATA_DIR">
      <RegistrySearch Id="NukaBoostDataDirSearch"
                      Root="HKCU"
                      Key="Software\NukaBoost"
                      Name="DataDir"
                      Type="raw" />
    </Property>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="NukaBoost">
          <!-- Registry KeyPaths are required for per-user components whose
               files live under the user profile (ICE38). -->
          <Component Id="MainExecutable" Guid="5E1777D0-F69B-4BAC-B21A-504ADE7C04EE">
            <File Id="NukaBoostExe" Source="!(bindpath.release)\NukaBoost.exe" />
            <RegistryValue Root="HKCU" Key="Software\NukaBoost\Components"
                           Name="MainExecutable" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="CtlExecutable" Guid="BFD95B89-79D8-4783-9D45-F998CBE3AC79">
            <File Id="NukaBoostCtlExe" Source="!(bindpath.release)\nukaboostctl.exe" />
            <RegistryValue Root="HKCU" Key="Software\NukaBoost\Components"
                           Name="CtlExecutable" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="InstallFolderCleanup" Guid="63D700A1-A600-426B-A64F-EA2224583D17">
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveProgramsFolderIfEmpty" Directory="ProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\NukaBoost\Components"
                           Name="InstallFolders" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="CommandLinePath" Guid="91FF5D88-1FA5-40C9-A9CD-931D9EF7E551">
            <Environment Id="AddInstallFolderToUserPath"
                         Name="PATH"
                         Value="[INSTALLFOLDER]"
                         Action="set"
                         Part="last"
                         Permanent="no"
                         System="no" />
            <RegistryValue Root="HKCU" Key="Software\NukaBoost\Components"
                           Name="CommandLinePath" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Component Id="RemoveAppData" Guid="FE9520D9-47FC-4E74-872B-57139851D979">
        <RegistryValue Root="HKCU" Key="Software\NukaBoost"
                       Name="DataDir" Type="string"
                       Value="[LocalAppDataFolder]NukaBoost" KeyPath="yes" />
        <util:RemoveFolderEx Id="RemoveNukaBoostData"
                             On="uninstall"
                             Property="NUKABOOST_DATA_DIR" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="NukaBoostProgramMenuFolder" Name="NukaBoost">
        <Component Id="StartMenuShortcut" Guid="AD7D423F-D9AC-451E-BBF1-3071A5BEE166">
          <Shortcut Id="StartMenuShortcutFile"
                    Name="NukaBoost"
                    Description="Keep Windows awake during long-running tasks"
                    Target="[INSTALLFOLDER]NukaBoost.exe"
                    Icon="NukaBoostIcon"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveNukaBoostProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\NukaBoost\Components"
                         Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder">
      <Component Id="StartupShortcut" Guid="F788BBDA-0846-421C-92CC-61E689AEB426">
        <Shortcut Id="StartupShortcutFile"
                  Name="NukaBoost"
                  Target="[INSTALLFOLDER]NukaBoost.exe"
                  Arguments="--startup"
                  Icon="NukaBoostIcon"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\NukaBoost\Components"
                       Name="StartupShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- A checked failure prevents uninstall from deleting the recovery
         tools while the original power plan is still unrestored. -->
    <CustomAction Id="DeactivateBeforeUninstall"
                  FileRef="NukaBoostCtlExe"
                  ExeCommand="exit"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />
    <CustomAction Id="DisableStartupBeforeUninstall"
                  FileRef="NukaBoostCtlExe"
                  ExeCommand="startup disable"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="DeactivateBeforeUninstall"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="DisableStartupBeforeUninstall"
              After="DeactivateBeforeUninstall"
              Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <Feature Id="MainFeature" Title="NukaBoost" Level="1"
             Description="Tray application and command-line utility. Select this item to view or change the installation folder."
             Display="expand"
             ConfigurableDirectory="INSTALLFOLDER"
             AllowAbsent="no"
             AllowAdvertise="no"
             InstallDefault="local">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="CtlExecutable" />
      <ComponentRef Id="InstallFolderCleanup" />
      <ComponentRef Id="CommandLinePath" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RemoveAppData" />
      <!-- The parent feature starts expanded so this opt-in is immediately
           visible. Level 2 keeps it disabled for a default Next/Next install. -->
      <Feature Id="StartupFeature" Title="Start NukaBoost with Windows (optional)" Level="2"
               Description="Launch NukaBoost at user sign-in. The application always starts inactive."
               AllowAdvertise="no"
               InstallDefault="local">
        <ComponentRef Id="StartupShortcut" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\NukaBoost-License.rtf" />
  </Package>
</Wix>
